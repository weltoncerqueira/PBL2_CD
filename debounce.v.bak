
module debounce (
    input clk,
    input rst,
    input botao,
    output botao_debounced
);

    wire sync;
    wire estado;
    wire mudou;

    wire [1:0] cont;
    wire contador_cheio;


    // -------------------------
    // Sincronizador
    // -------------------------

    sincronizador_2ff sincronizador (
        .clk(clk),
        .rst(rst),
        .botao(botao),
        .sync(sync)
    );


    // -------------------------
    // Detecta mudança
    // -------------------------

    xor (mudou, sync, estado);


    // -------------------------
    // Contador
    // -------------------------

    contador_debounce_2b contador (
        .clk(clk),
        .rst(rst),
        .mudou(mudou),
        .cont(cont)
    );


    // -------------------------
    // Detecta 11
    // -------------------------

    and (contador_cheio, cont[1], cont[0]);


    // -------------------------
    // Atualiza estado estável
    // -------------------------

    estado_botao estado_ff (
        .clk(clk),
        .rst(rst),
        .D(sync),
        .load(contador_cheio),
        .Q(estado)
    );


    assign botao_debounced = estado;

endmodule


module estado_botao (
    input clk,
    input rst,
    input D,
    input load,
    output Q
);

    wire D_mux;

    mux21_1b MUX (
        .A(Q),
        .B(D),
        .S(load),
        .Y(D_mux)
    );

    ff_D FF (
        .D(D_mux),
        .clk(clk),
        .reset(rst),
        .Q(Q)
    );

endmodule


module sincronizador_2ff (
    input clk,
    input rst,
    input botao,
    output sync
);

    wire q1;

    ff_D FF1 (
        .D(botao),
        .clk(clk),
        .reset(rst),
        .Q(q1)
    );

    ff_D FF2 (
        .D(q1),
        .clk(clk),
        .reset(rst),
        .Q(sync)
    );

endmodule


module contador_debounce_2b (
    input clk,
    input rst,
    input mudou,
    output [1:0] cont
);

    wire T0, T1;
    wire reset_cont;

    // FF0 sempre alterna enquanto mudou = 1
    assign T0 = mudou;

    // FF1 alterna quando mudou = 1 e cont[0] = 1
    assign T1 = mudou & cont[0];

    // Se não houve mudança, zera o contador
    assign reset_cont = rst | ~mudou;

    ff_T FFT0 (
        .t(T0),
        .clk(clk),
        .rst(reset_cont),
        .q(cont[0])
    );

    ff_T FFT1 (
        .t(T1),
        .clk(clk),
        .rst(reset_cont),
        .q(cont[1])
    );

endmodule