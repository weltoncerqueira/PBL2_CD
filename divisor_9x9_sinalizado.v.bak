module divisor_9x9_sinalizado (
	input  [8:0] A,
	input  [8:0] B,
	output [8:0] S,
	output [8:0] resto 
	
);
	
	wire [8:0] A_final, B_final, div_result, resto_sem_sinal;
	wire sinal;
	 
	// Sinais iguais = 0, Sinais diferentes = 1
	xor (sinal, A[8], B[8]);
	
	numero_Final num1 (.entrada(A), .valor_absoluto(A_final));
   numero_Final num2 (.entrada(B), .valor_absoluto(B_final));
	
	divisor_9bits div1(
		.A(A_final),
		.B(B_final),
		.Q(div_result),
		.R(resto_sem_sinal)
	);
	
  complementoDe2_9bits complemento4 (
		 .A(div_result), 
		 .bs(sinal),
		 .out(S)
	 );
	 
	complementoDe2_9bits complemento2 (
       .A(resto_sem_sinal),
       .bs(A[8]),            // resto segue APENAS o sinal do dividendo
       .out(resto)
    );
	 
	 
endmodule
