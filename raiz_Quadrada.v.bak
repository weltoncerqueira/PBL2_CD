
// =====================================================================
// sqrt4.v
// Raiz quadrada inteira de um numero de 4 bits, 100% ESTRUTURAL.
//
// Regras seguidas: nenhuma linha usa 'always', 'if' ou 'assign'.
// Apenas: module/endmodule, input/output, wire e portas primitivas
// (not, and, or).
//
// Entrada:  A[3:0] -> 0 a 15
// Saida:    S[1:0] -> floor(sqrt(A)), de 0 a 3
//
// Estrategia: como o dominio de entrada e pequeno (16 combinacoes),
// a solucao foi extrair a tabela-verdade completa e minimizar com
// mapa de Karnaugh, chegando em duas equacoes simples (soma de
// produtos) implementadas diretamente em portas logicas.
//
// Tabela-verdade:
//   A = 0            -> S = 0  (00)
//   A = 1,2,3         -> S = 1  (01)
//   A = 4,5,6,7,8      -> S = 2  (10)
//   A = 9..15          -> S = 3  (11)
// =====================================================================

module raiz_Quadrada(A, S);
    input  [3:0] A;
    output [1:0] S;

    wire nA3, nA2;
    wire or_a1a0;     // A1 + A0
    wire or_a2a1a0;   // A2 + A1 + A0
    wire term1;       // ~A3 . ~A2 . (A1+A0)   -> cobre A = 1,2,3
    wire term2;       // A3 . (A2+A1+A0)       -> cobre A = 9..15

    not (nA3, A[3]);
    not (nA2, A[2]);

    or  (or_a1a0,   A[1], A[0]);
    or  (or_a2a1a0, A[2], A[1], A[0]);

    and (term1, nA3, nA2, or_a1a0);
    and (term2, A[3], or_a2a1a0);

    // S1 = A3 + A2  (resultado >= 2 sempre que A >= 4)
    or (S[1], A[3], A[2]);

    // S0 = term1 + term2
    or (S[0], term1, term2);

endmodule
